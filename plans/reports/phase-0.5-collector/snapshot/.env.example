# RaiseMyFish 环境变量模板
# 复制为 .env 并填入真实值；.env 不入仓。

# 数据库（必填）
FISH_DB_DSN=postgres://fish:CHANGE_ME@127.0.0.1:5432/raisemyfish?sslmode=disable

# 大模型（必填）
FISH_LLM_KEY=sk-CHANGE_ME
# 可选：覆盖配置里的 base_url / model
# FISH_LLM_BASE_URL=https://api.deepseek.com/v1
# FISH_LLM_MODEL=deepseek-chat

# B站（Phase 0 起）
# 二选一：直接给 cookie 字符串，或给文件路径
# FISH_BILI_COOKIE=...
# FISH_BILI_COOKIE_FILE=C:/Users/you/.bili-ai/credentials.json
# 启用live采集时填写（自身UID须与Cookie账号nav结果一致）
# FISH_BILI_ROOM_ID=123
# FISH_BILI_SELF_ID=456

# QQ（Phase 3 起）
# FISH_QQ_TOKEN=...

# 日志
FISH_LOG_LEVEL=info

# 预算（可选，元/天）
# FISH_DAILY_BUDGET=20
